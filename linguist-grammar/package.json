{
  "name": "language-blyx-grammar",
  "displayName": "Blyx TextMate Grammar",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone, MIT-licensed TextMate grammar for the Blyx programming language",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rahulchaube1/language-blyx-grammar.git"
  },
  "contributes": {
    "languages": [
      {
        "id": "blyx",
        "aliases": [
          "Blyx",
          "blyx"
        ],
        "extensions": [
          ".blyx"
        ]
      }
    ],
    "grammars": [
      {
        "language": "blyx",
        "scopeName": "source.blyx",
        "path": "./grammars/blyx.tmLanguage.json"
      }
    ]
  }
}
