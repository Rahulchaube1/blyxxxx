// Blyx bootstrap compiler. Source arrives on stdin; the executable leaves on stdout.
// Scratch cells 0..31 hold cursors. All tables have explicitly checked capacities.
// Source bytes start at 1024, code bytes at 270000, function records at 1400000,
// call fixups at 1430000, local bindings at 1550000. Addresses are cell indices.
use std::bootstrap;

fn message(s: String) {
    let mut i = 0;
    while i < boot_len(s) { boot_err(boot_char(s, i)); i = i + 1; }
}
fn digits_err(n: i64) {
    if n >= 10 { digits_err(n / 10); }
    boot_err(48 + n % 10);
}
fn reject(s: String) {
    message("blyxc: "); message(s); message(" at source byte ");
    digits_err(boot_get(2)); boot_err(10); boot_exit(1);
}
fn source(i: i64) -> i64 {
    if i >= boot_get(0) { return -1; }
    return boot_get(1024 + i);
}
// The build driver can prefix this comment to select a cross target.
fn starts_source(s: String) -> bool {
    let mut i=0;
    while i<boot_len(s) {
        if source(i)!=boot_char(s,i) { return false; }
        i=i+1;
    }
    return true;
}
fn windows_target() -> bool { return boot_get(15) == 1; }
fn letter(c: i64) -> bool {
    return c == 95 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
}
fn digit(c: i64) -> bool { return c >= 48 && c <= 57; }
fn is_pair(a: i64, b: i64) -> bool {
    return ((a == 60 || a == 62 || a == 33 || a == 61 || a == 43 || a == 45 || a == 42 || a == 47 || a == 37) && b == 61)
        || (a == 45 && b == 62) || (a == 38 && b == 38) || (a == 124 && b == 124) || (a == 58 && b == 58);
}
fn advance() {
    let mut i = boot_get(1);
    let mut c = source(i);
    while c == 32 || c == 10 || c == 13 || c == 9 || (c == 47 && source(i + 1) == 47) {
        if c == 47 { while source(i) >= 0 && source(i) != 10 { i = i + 1; } }
        else { i = i + 1; }
        c = source(i);
    }
    boot_set(2, i);
    if c < 0 { boot_set(1, i); return; }
    i = i + 1;
    if letter(c) {
        while letter(source(i)) || digit(source(i)) { i = i + 1; }
    } else {
        if digit(c) { while digit(source(i)) { i = i + 1; } }
        else {
            if c == 34 {
                while source(i) != 34 {
                    if source(i) < 0 || source(i) == 10 { reject("unterminated string"); }
                    if source(i) == 92 { i = i + 1; }
                    i = i + 1;
                }
                i = i + 1;
            } else { if is_pair(c, source(i)) { i = i + 1; } }
        }
    }
    boot_set(1, i);
}
fn token(s: String) -> bool {
    let p = boot_get(2);
    let n = boot_get(1) - p;
    if n != boot_len(s) { return false; }
    let mut i = 0;
    while i < n {
        if source(p + i) != boot_char(s, i) { return false; }
        i = i + 1;
    }
    return true;
}
fn take(s: String) -> bool { if token(s) { advance(); return true; } return false; }
fn expect(s: String) { if !take(s) { message("expected "); reject(s); } }
fn ident() -> i64 {
    let p = boot_get(2);
    if !letter(source(p)) { reject("expected identifier"); }
    advance(); return p;
}
fn same(a: i64, b: i64) -> bool {
    let mut i = 0;
    while letter(source(a+i)) || digit(source(a+i)) {
        if source(a+i) != source(b+i) { return false; }
        i = i + 1;
    }
    return !letter(source(b+i)) && !digit(source(b+i));
}
fn pos() -> i64 { return boot_get(3); }
fn emit(n: i64) {
    if pos() >= 1048576 { reject("machine code size limit"); }
    if n < 0 || n > 255 { reject("invalid instruction byte"); }
    boot_set(270000 + pos(), n); boot_set(3, pos() + 1);
}
fn nibble(c: i64) -> i64 {
    if digit(c) { return c - 48; }
    if c >= 97 && c <= 102 { return c - 87; }
    reject("bad hex digit in emitter"); return 0;
}
// Hex pairs below are x86-64 instructions. Spaces separate instructions or operands.
fn hex(s: String) {
    let mut i = 0;
    while i < boot_len(s) {
        if boot_char(s,i) == 32 { i = i + 1; }
        else { emit(nibble(boot_char(s,i))*16 + nibble(boot_char(s,i+1))); i = i + 2; }
    }
}
fn low(n: i64) -> i64 { return (n % 256 + 256) % 256; }
fn next_byte(n: i64) -> i64 {
    let q = n / 256;
    if n % 256 < 0 { return q - 1; }
    return q;
}
fn little(n: i64, count: i64) {
    let mut x = n; let mut i = 0;
    while i < count { emit(low(x)); x = next_byte(x); i = i + 1; }
}
fn patch(p: i64, n: i64) {
    let mut x = n; let mut i = 0;
    while i < 4 { boot_set(270000+p+i,low(x)); x = next_byte(x); i = i + 1; }
}
fn branch(op: String) -> i64 { hex(op); let p = pos(); little(0,4); return p; }
fn resolve(p: i64, dest: i64) { patch(p,dest-p-4); }
fn literal(n: i64) { hex("48b8"); little(n,8); }
fn typename() -> i64 {
    if take("i64") { return 1; } if take("bool") { return 2; }
    if take("String") { return 3; }
    reject("type outside the direct compiler"); return 0;
}
fn require_type(actual: i64, expected: i64) { if actual != expected && actual != 4 { reject("type mismatch"); } }
// Function record: name, code position, result type, arity, then up to eight parameter types.
fn record(i: i64) -> i64 { return 1400000+i*12; }
fn find_function(name: i64) -> i64 {
    let mut i = 0; while i < boot_get(4) {
        if same(name,boot_get(record(i))) { return i; } i = i + 1;
    }
    return -1;
}
fn call_fixup(i: i64) {
    let n = boot_get(5);
    if n >= 32768 { reject("call fixup limit"); }
    boot_set(1430000+n*2,branch("e8")); boot_set(1430001+n*2,i); boot_set(5,n+1);
}
// A local record holds the name, signed frame offset, type and mutability.
fn local(name: i64, displacement: i64, ty: i64, mutable: i64) {
    let n = boot_get(6);
    if n >= 1024 { reject("local binding limit"); }
    let p = 1550000+n*4;
    boot_set(p,name); boot_set(p+1,displacement); boot_set(p+2,ty); boot_set(p+3,mutable);
    boot_set(6,n+1);
}
fn binding(name: i64) -> i64 {
    let mut i = boot_get(6);
    while i > 0 { i = i-1; let p = 1550000+i*4; if same(name,boot_get(p)) { return p; } }
    reject("unknown binding"); return 0;
}
fn typed_params(i: i64, bind: bool) {
    let f = record(i); let mut n = 0;
    expect("(");
    if !take(")") {
        loop {
            if n >= 8 { reject("at most eight parameters"); }
            let name = ident(); expect(":"); let ty = typename();
            if bind { local(name,16+8*(boot_get(f+3)-n-1),ty,0); }
            boot_set(f+4+n,ty); n = n+1;
            if take(")") { break; } expect(",");
        }
    }
    boot_set(f+3,n); let mut result = 0;
    if take("->") { result = typename(); } boot_set(f+2,result);
}
fn skip_body() {
    expect("{"); let mut depth = 1;
    while depth > 0 {
        if token("") { reject("unclosed function"); }
        if token("{") { depth = depth+1; }
        if token("}") { depth = depth-1; }
        advance();
    }
}
fn string_value() {
    let begin = boot_get(2)+1; let end = boot_get(1)-1; advance();
    let over = branch("e9"); let data = pos(); little(0,8); let mut i = begin;
    while i < end {
        let mut c = source(i); i = i+1;
        if c == 92 {
            c = source(i); i = i+1;
            if c == 110 { c = 10; } else { if c == 114 { c = 13; } else {
                if c == 116 { c = 9; } else { if c != 92 && c != 34 { reject("unsupported escape"); } }
            } }
        }
        emit(c);
    }
    patch(data,pos()-data-8); resolve(over,pos());
    resolve(branch("488d05"),data);
}

// Builtin ids also index their generated runtime entry points, at cells 40..53.
fn builtin() -> i64 {
    if token("boot_argc") { return 13; } if token("boot_flag") { return 14; }
    if token("boot_input") { return 15; } if token("boot_output") { return 16; }
    if token("boot_get") { return 1; } if token("boot_set") { return 2; }
    if token("boot_len") { return 3; } if token("boot_char") { return 4; }
    if token("boot_read") { return 5; } if token("boot_write") { return 6; }
    if token("boot_err") { return 7; } if token("boot_exit") { return 8; }
    if token("boot_windows") { return 9; } return 0;
}
fn invoke_builtin(id: i64) { resolve(branch("e8"),boot_get(40+id)); }
fn intrinsic(id: i64) -> i64 {
    if boot_get(13) == 0 { reject("missing use std::bootstrap"); }
    advance(); expect("(");
    if id != 5 && id != 9 && id != 13 {
        let needed = if id == 3 || id == 4 { 3 } else { 1 };
        require_type(expr(1),needed); emit(80);
        if id == 2 || id == 4 { expect(","); require_type(expr(1),1); emit(80); }
        if id == 14 { expect(","); require_type(expr(1),3); emit(80); }
    }
    expect(")"); invoke_builtin(id);
    if id != 5 && id != 9 && id != 13 { hex("4883c408"); }
    if id == 2 || id == 4 || id == 14 { hex("4883c408"); }
    if id == 8 { return 4; } if id == 9 || id >= 14 { return 2; }
    if id == 2 || id == 6 || id == 7 { return 0; } return 1;
}
fn print_value(newline: bool) -> i64 {
    expect("!"); expect("(");
    if !token(")") {
        let t = expr(1); emit(80);
        if t == 1 { invoke_builtin(10); } else {
            if t == 3 { invoke_builtin(11); } else {
                if t == 2 { invoke_builtin(12); } else { reject("unprintable value"); }
            }
        }
        hex("4883c408");
    }
    expect(")");
    if newline { hex("6a0a"); invoke_builtin(6); hex("4883c408"); }
    return 0;
}
fn primary() -> i64 {
    if take("(") { if take(")") { return 0; } let t = expr(1); expect(")"); return t; }
    if take("-") {
        if take("9223372036854775808") { literal(-9223372036854775807-1); return 1; }
        require_type(primary(),1); hex("48f7d8"); trap_if("0f80"); return 1;
    }
    if token("loop") { return compile_loop(); }
    if token("{") { return block(); }
    if take("!") { require_type(primary(),2); hex("4883f001"); return 2; }
    if take("true") { literal(1); return 2; }
    if take("false") { literal(0); return 2; }
    if take("if") {
        require_type(expr(1),2); hex("4885c0"); let alt = branch("0f84");
        let yes = block(); let done = branch("e9"); resolve(alt,pos());
        let mut no = 0;
        if take("else") { if token("if") { no = primary(); } else { no = block(); } }
        resolve(done,pos());
        if yes == 4 { return no; } if no == 4 { return yes; }
        require_type(yes,no); return yes;
    }
    let start = boot_get(2); let c = source(start);
    if c == 34 { string_value(); return 3; }
    if digit(c) {
        let mut i = start; let mut n = 0;
        while i < boot_get(1) {
            let d = source(i)-48;
            if n > (9223372036854775807-d)/10 { reject("integer literal exceeds i64"); }
            n = n*10+d; i = i+1;
        }
        advance(); literal(n); return 1;
    }
    if take("println") { return print_value(true); }
    if take("print") { return print_value(false); }
    let id = builtin(); if id != 0 { return intrinsic(id); }
    let name = ident();
    if take("(") {
        let f = find_function(name); if f < 0 { reject("unknown function"); }
        let p = record(f); let mut n = 0;
        if !take(")") {
            loop {
                if n >= boot_get(p+3) { reject("too many arguments"); }
                require_type(expr(1),boot_get(p+4+n)); emit(80); n = n+1;
                if take(")") { break; } expect(",");
            }
        }
        if n != boot_get(p+3) { reject("too few arguments"); }
        call_fixup(f); if n > 0 { hex("4883c4"); emit(n*8); }
        return boot_get(p+2);
    }
    let p = binding(name);
    hex("488b85"); little(boot_get(p+1),4); return boot_get(p+2);
}
fn precedence() -> i64 {
    if token("||") { return 1; } if token("&&") { return 2; }
    if token("==") || token("!=") { return 3; }
    if token("<") || token(">") || token("<=") || token(">=") { return 4; }
    if token("+") || token("-") { return 5; }
    if token("*") || token("/") || token("%") { return 6; } return 0;
}
fn trap_if(op: String) { resolve(branch(op),boot_get(40)); }
fn arithmetic(a:i64) {
    if a == 43 { hex("4801c8"); trap_if("0f80"); }
    if a == 45 { hex("4829c8"); trap_if("0f80"); }
    if a == 42 { hex("480fafc1"); trap_if("0f80"); }
    if a == 47 || a == 37 {
        hex("4885c9"); trap_if("0f84");
        hex("4883f9ff"); let ok = branch("0f85");
        hex("4889c2 48f7da"); trap_if("0f80"); resolve(ok,pos());
        hex("4899 48f7f9"); if a == 37 { hex("4889d0"); }
    }
}
fn expr(level: i64) -> i64 {
    let mut ty = primary(); let mut p = precedence();
    while p >= level {
        let a = source(boot_get(2)); let pair = boot_get(1)-boot_get(2) == 2;
        advance();
        if p <= 2 {
            require_type(ty,2); hex("4885c0");
            let skip = if p == 1 { branch("0f85") } else { branch("0f84") };
            require_type(expr(p+1),2); resolve(skip,pos()); ty = 2;
        } else {
            emit(80); let rhs = expr(p+1);
            require_type(rhs,ty); hex("4889c1 58");
            if p >= 5 {
                require_type(ty,1);
                arithmetic(a);
            } else {
                if p == 3 { if ty != 1 && ty != 2 { reject("unsupported equality operands"); } }
                else { require_type(ty,1); }
                hex("4839c8 0f");
                if a == 61 { emit(148); } if a == 33 { emit(149); }
                if a == 60 { emit(if pair { 158 } else { 156 }); }
                if a == 62 { emit(if pair { 157 } else { 159 }); }
                hex("c0 480fb6c0"); ty = 2;
            }
        }
        p = precedence();
    }
    return ty;
}
fn block() -> i64 {
    expect("{"); let mark = boot_get(6); let mut ty = 0; let mut falls = true;
    while !take("}") {
        if token("") { reject("unclosed block"); }
        ty = statement();
        if ty == 4 { falls = false; }
    }
    boot_set(6,mark);
    if !falls { return 4; } return ty;
}
fn statement() -> i64 {
    if take("let") {
        let mutable = if take("mut") { 1 } else { 0 }; let name = ident();
        let mut annotation = -1; if take(":") { annotation = typename(); }
        expect("="); let t = expr(1); if annotation >= 0 { require_type(t,annotation); }
        expect(";"); let slot = boot_get(8)+1; boot_set(8,slot);
        local(name,-slot*8,t,mutable); hex("488985"); little(-slot*8,4); return 0;
    }
    if take("return") {
        let mut t = 0; if !token(";") { t = expr(1); } require_type(t,boot_get(9));
        expect(";"); hex("c9c3"); return 4;
    }
    if token("loop") || token("while") { let t=compile_loop(); if take(";") { return 0; } return t; }
    if take("break") {
        if boot_get(10) < 0 { reject("break outside loop"); }
        let mut t=0; if !token(";") { t=expr(1); }
        if boot_get(21)<0 { boot_set(21,t); } else { require_type(t,boot_get(21)); }
        expect(";"); hex("488ba5"); little(boot_get(22),4); let b = branch("e9");
        if b >= 490000 { reject("break fixup limit"); }
        boot_set(1600000+b,boot_get(11)); boot_set(11,b); return 4;
    }
    if take("continue") {
        if boot_get(10) < 0 { reject("continue outside loop"); }
        expect(";"); hex("488ba5"); little(boot_get(22),4); resolve(branch("e9"),boot_get(10)); return 4;
    }
    let was_if = token("if"); let start = boot_get(2); let end = boot_get(1);
    if letter(source(start)) && !was_if {
        advance();
        if token("=") || token("+=") || token("-=") || token("*=") || token("/=") || token("%=") {
            let p = binding(start); if boot_get(p+3) == 0 { reject("immutable binding"); }
            let op = source(boot_get(2)); advance();
            if op != 61 { hex("ffb5"); little(boot_get(p+1),4); }
            require_type(expr(1),boot_get(p+2)); expect(";");
            if op != 61 {
                require_type(boot_get(p+2),1); hex("4889c1 58");
                arithmetic(op);
            }
            hex("488985"); little(boot_get(p+1),4); return 0;
        }
        boot_set(2,start); boot_set(1,end);
    }
    let t = expr(1); if take(";") { if t == 4 { return 4; } return 0; }
    if !was_if && !token("}") { reject("expected semicolon"); }
    return t;
}
fn compile_loop() -> i64 {
    let forever=token("loop"); advance();
    let saved_stack=boot_get(22); let slot=boot_get(8)+1; boot_set(8,slot);
    let displacement=-slot*8; hex("4889a5"); little(displacement,4);
    let start=pos(); let mut done=-1;
    if !forever { require_type(expr(1),2); hex("4885c0"); done=branch("0f84"); }
    let outer=boot_get(10); let saved=boot_get(11); let saved_type=boot_get(21);
    boot_set(10,start); boot_set(11,-1); boot_set(21,if forever {-1} else {0}); boot_set(22,displacement);
    block(); resolve(branch("e9"),start); if done>=0 { resolve(done,pos()); }
    let mut br=boot_get(11); while br>=0 {
        let prev=boot_get(1600000+br); resolve(br,pos()); br=prev;
    }
    let ty=boot_get(21); boot_set(10,outer); boot_set(11,saved); boot_set(21,saved_type); boot_set(22,saved_stack);
    if ty<0 { return 4; } return ty;
}
fn functions(bind: bool) {
    boot_set(1,0); advance(); boot_set(13,0);
    if take("use") { expect("std"); expect("::"); expect("bootstrap"); expect(";"); boot_set(13,1); }
    let mut i = 0;
    while !token("") {
        take("pub"); expect("fn"); let main_fn = token("main"); let name = ident();
        if !bind {
            if i >= 1024 { reject("function limit"); }
            if find_function(name) >= 0 { reject("duplicate function"); }
            boot_set(record(i),name); boot_set(4,i+1);
            if main_fn { boot_set(12,i); }
        }
        boot_set(6,0); boot_set(8,0); typed_params(i,bind);
        if main_fn && (boot_get(record(i)+3) != 0 || boot_get(record(i)+2) != 0) { reject("expected fn main()"); }
        if bind {
            boot_set(record(i)+1,pos()); boot_set(9,boot_get(record(i)+2)); boot_set(10,-1);
            hex("55 4889e5 4881ec"); let frame = pos(); little(0,4);
            let result = block(); require_type(result,boot_get(9)); hex("c9c3"); patch(frame,boot_get(8)*8);
        } else { skip_body(); }
        i = i+1;
    }
}

// PE imports live in a dedicated .idata section. Each thunk is eight bytes.
fn win_api(i: i64) {
    let entry=boot_get(16);
    if entry>=64 { reject("import fixup limit"); }
    hex("ff15"); boot_set(1570000+2*entry,pos()); boot_set(1570001+2*entry,i);
    little(0,4); boot_set(16,entry+1);
}
// Loader metadata precedes the Blyx workspace, outside its accessible indices.
fn metadata_ptr() {
    let i=boot_get(20); if i>=32 { reject("loader fixup limit"); }
    hex("4c8d15"); boot_set(1570200+i,pos()); little(0,4); boot_set(20,i+1);
}
fn fix_memory(arena: i64) {
    let mut i=0;
    while i<boot_get(20) { resolve(boot_get(1570200+i),arena); i=i+1; }
    resolve(boot_get(18),arena+64); resolve(boot_get(19),arena+64);
}
fn capture_args() {
    if windows_target() {
        hex("4889e3 4883e4f0 4883ec30"); win_api(5);
        hex("4889c1 488d542428"); win_api(11);
        metadata_ptr(); hex("49894208 8b442428 498902 4889dc");
    } else { metadata_ptr(); hex("488b0424 498902 488d442408 49894208"); }
}
fn arg_ptr(offset: i64) {
    metadata_ptr(); hex("488b4424"); emit(offset);
    hex("48ffc0 4885c0"); trap_if("0f8e"); hex("493b02"); trap_if("0f83");
    hex("498b5208 488b0cc2");
}
fn open_arg(input: bool) {
    arg_ptr(8);
    if windows_target() {
        hex("55 4889e5 4883e4f0 4883ec40 ba"); little(if input {2147483648} else {1073741824},4);
        hex("41b8"); little(if input {1} else {0},4);
        hex("4531c9 48c7442420"); little(if input {3} else {1},4);
        hex("48c744242880000000 48c744243000000000"); win_api(6);
        hex("4883f8ff"); let fail = branch("0f84"); hex("4889c2 b9"); little(if input {-10} else {-11},4);
        win_api(7); hex("85c0 0f95c0 0fb6c0 c9c3"); resolve(fail,pos()); hex("31c0 c9c3");
    } else {
        hex("4889cf be"); little(if input {0} else {193},4);
        hex("bae9010000 b802000000 0f05 4885c0"); let fail=branch("0f88");
        hex("4889c7 be"); little(if input {0} else {1},4);
        hex("b821000000 0f05 4885c0 0f99c0 0fb6c0 c3"); resolve(fail,pos()); hex("31c0 c3");
    }
}
fn cli_runtime() {
    boot_set(53,pos()); metadata_ptr(); hex("498b02 48ffc8 c3");
    boot_set(54,pos()); arg_ptr(16); hex("488b542408 4531c0");
    let check=pos(); hex("4c3b02"); let end=branch("0f83");
    if windows_target() { hex("420fb70441"); } else { hex("420fb60401"); }
    hex("420fb6740208 39f0"); let no=branch("0f85"); hex("49ffc0"); resolve(branch("e9"),check);
    resolve(end,pos()); if windows_target() { hex("6642833c4100"); } else { hex("42803c0100"); }
    hex("0f94c0 0fb6c0 c3"); resolve(no,pos()); hex("31c0 c3");
    boot_set(55,pos()); open_arg(true); boot_set(56,pos()); open_arg(false);
}
fn exit_code() {
    if windows_target() { hex("89c1 4883e4f0 4883ec20"); win_api(3); }
    else { hex("4889c7 b83c000000 0f05"); }
    hex("0f0b");
}
fn byte_io(id: i64) {
    boot_set(40+id,pos());
    let input = id == 5;
    if !input { hex("48817c2408 ff000000"); trap_if("0f87"); }
    if windows_target() {
        hex("55 4889e5 4883e4f0 4883ec40 b9");
