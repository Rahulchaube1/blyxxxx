// Serialize OS headers after resolving every call. Code is read/execute;
// the zero-filled, bounds-checked workspace is in a separate read/write mapping.
fn out(n: i64, size: i64) {
    let mut i=0; let mut v=n;
    while i<size { boot_write(low(v)); v=next_byte(v); i=i+1; }
    boot_set(14,boot_get(14)+size);
}
fn pad(dest: i64) {
