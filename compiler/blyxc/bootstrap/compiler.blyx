    hex("48837d1000"); let skip = branch("0f89"); hex("c6062d 48ffce"); resolve(skip,pos());
    hex("48ffc6 488975d8"); let put = pos(); hex("488b75d8 0fb606 50"); invoke_builtin(6);
    hex("4883c408 48ff45d8 48396dd8"); resolve(branch("0f85"),put); hex("c9c3");
    boot_set(51,pos()); hex("55 4889e5 4883ec08 48c745f800000000");
    let each = pos(); hex("488b5510 488b45f8 483b02"); let end = branch("0f83");
