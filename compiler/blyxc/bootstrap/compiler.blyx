fn main() {
    let args=boot_argc();
    if args==1 {
        if boot_flag(0,"--version") { println!("blyxc direct 0.1.0"); return; }
        if boot_flag(0,"--help") { println!("blyxc build INPUT.blyx -o NEW_EXECUTABLE"); return; }
    }
    if args!=0 {
        if args!=4 || !boot_flag(0,"build") || !boot_flag(2,"-o") {
            message("usage: blyxc build INPUT.blyx -o NEW_EXECUTABLE"); boot_err(10); boot_exit(2);
        }
        if !boot_input(1) { reject("cannot open input file"); }
    }
    let mut n=0; let mut c=boot_read();
    while c>=0 {
        if n>=262144 { reject("source exceeds 256 KiB"); }
        boot_set(1024+n,c); n=n+1; c=boot_read();
    }
    boot_set(0,n); boot_set(12,-1);
    if starts_source("// blyxc-target: linux-x86_64\n") { boot_set(15,0); }
    else { if starts_source("// blyxc-target: windows-x86_64\n") || boot_windows() { boot_set(15,1); } }
    functions(false);
    if boot_get(12)<0 { reject("missing fn main()"); }
    if boot_get(13)!=0 { capture_args(); }
    call_fixup(boot_get(12)); literal(0); exit_code();
    runtime(); functions(true);
    let mut i=0;
    while i<boot_get(5) {
        let entry=1430000+i*2; resolve(boot_get(entry),boot_get(record(boot_get(entry+1))+1)); i=i+1;
    }
    if args!=0 && !boot_output(3) { reject("cannot create output (choose a new file)"); }
    if windows_target() { pe(); } else { elf(); }
}
