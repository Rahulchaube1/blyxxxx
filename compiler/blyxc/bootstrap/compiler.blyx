    while boot_get(14)<dest { out(0,1); }
}
fn ascii(s: String) { let mut i=0; while i<boot_len(s) { out(boot_char(s,i),1); i=i+1; } }
fn body() { let mut i=0; while i<pos() { out(boot_get(270000+i),1); i=i+1; } }
fn workspace_size() -> i64 { if boot_get(13)!=0 { return 16777280; } return 64; }
fn segment(kind: i64, flags: i64, addr: i64, file: i64, mem: i64, align: i64) {
    out(kind,4); out(flags,4); out(0,8); out(addr,8); out(addr,8); out(file,8); out(mem,8); out(align,8);
}
fn elf() {
