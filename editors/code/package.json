{
  "name": "blyx-language",
  "displayName": "Blyx Language",
  "description": "Blyx language syntax highlighting and snippets for VS Code.",
  "version": "0.1.0-alpha",
  "publisher": "RahulChaube",
  "license": "MIT",
  "icon": "blyx.png",
  "homepage": "https://blyx-lang.space",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rahulchaube1/blyxxxx.git"
  },
  "bugs": {
    "url": "https://github.com/Rahulchaube1/blyxxxx/issues"
  },
  "keywords": [
    "blyx",
    "programming-language",
    "compiler",
    "systems-programming",
    "ai-native",
    "tensor",
    "actor",
    "open-source"
  ],
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "blyx",
        "aliases": ["Blyx", "blyx"],
        "extensions": [".blyx"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "blyx",
        "scopeName": "source.blyx",
        "path": "./syntaxes/blyx.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "blyx",
        "path": "./snippets/blyx.json"
      }
    ]
  }
}
