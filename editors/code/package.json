{
  "name": "blyx-language",
  "displayName": "Blyx Language",
  "description": "Run Blyx with the bundled interpreter, see syntax diagnostics and build native executables with Blyx Direct.",
  "version": "1.4.0",
  "publisher": "RahulChaube",
  "license": "MIT",
  "icon": "blyx.png",
  "homepage": "https://blyx-lang.space",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rahulchaube1/blyxxxx.git"
  },
  "bugs": {
    "url": "https://github.com/Rahulchaube1/blyxxxx/issues"
  },
  "keywords": [
    "blyx",
    "programming-language",
    "compiler",
    "systems-programming",
    "ai-native",
    "tensor",
    "actor",
    "open-source"
  ],
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "blyx",
        "aliases": [
          "Blyx",
          "blyx"
        ],
        "extensions": [
          ".blyx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./blyx.png",
          "dark": "./blyx.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "blyx",
        "scopeName": "source.blyx",
        "path": "./syntaxes/blyx.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "blyx",
        "path": "./snippets/blyx.json"
      }
    ],
    "commands": [
      {
        "command": "blyx.run",
        "title": "Blyx: Run File",
        "icon": "$(play)"
      },
      {
        "command": "blyx.buildNative",
        "title": "Blyx: Build Native Executable",
        "enablement": "isWorkspaceTrusted && resourceLangId == blyx && resourceScheme == file"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "blyx.run",
          "when": "resourceLangId == blyx",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "blyx.buildNative",
          "when": "resourceLangId == blyx"
        }
      ]
    },
    "configuration": {
      "title": "Blyx",
      "properties": {
        "blyx.directCompilerPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the installed Blyx Direct compiler. Leave empty to select the executable when building."
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage:blyx"
  ],
  "scripts": {
    "vscode:prepublish": "node scripts/prepare.cjs"
  }
}
